<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Signature-level permission of the shared model library (MLP/1). Both
         host flavours are listed because debug installs as <pkg>.tmp; the
         permission name is derived from the host package, not ours. -->
    <uses-permission android:name="com.viitorvoice.modelhost.tmp.permission.MODELS" />
    <uses-permission android:name="com.viitorvoice.modelhost.permission.MODELS" />

    <!-- Package visibility (API 30+): the shared model library lives in another
         app, so both releases of the host must be declared or neither the
         provider lookup nor contentResolver.call() can reach them. -->
    <queries>
        <package android:name="com.viitorvoice.modelhost.tmp" />
        <package android:name="com.viitorvoice.modelhost" />
    </queries>

    <application
        android:name=".VvApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ViiTorVoice">

        <!-- QNN HTP's stub chain dlopens these by soname at deviceCreate; without
             the declaration the app linker namespace (clns) refuses to resolve
             them. required=false so the app still installs elsewhere. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ViiTorVoice">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ASR/VAD/aligner run in their own process: the 1.5 GB aligner can
             trip lmkd, and the editor must survive that. -->
        <provider
            android:name=".asr.AsrProvider"
            android:authorities="${applicationId}.asr"
            android:exported="false"
            android:process=":asr" />

    </application>

</manifest>
